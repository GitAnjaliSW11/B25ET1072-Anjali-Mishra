#include <iostream>
using namespace std;
int multiply(int a, int b) {
    return a * b;
}

int multiply(int a, int b, int c) {
    return a * b * c;
}

int main() {
    int x1, x2;
    int y1, y2, y3;
    cout << "Enter two integers to multiply: ";
    cin >> x1 >> x2;
    int result1 = multiply(x1, x2);
    cout << "Product of two integers: " << result1 << endl << endl;
    
    cout << "Enter three integers to multiply: ";
    cin >> y1 >> y2 >> y3;
    int result2 = multiply(y1, y2, y3);
    cout << "Product of three integers: " << result2 << endl;
    return 0;
}
