#include <iostream>
using namespace std;
long long fct(int n) {
    long long f = 1;
    for (int i = 1; i <= n; ++i) {
        f *= i;
    }
    return f;
}
int main() {
    int rows;
    cout<<"Enter number of rows for Pascal's Triangle: ";
    cin>>rows;
    cout<<"\nHere's your triangle:\n" << endl;
    for(int i=0; i<rows; ++i) {
        for(int s=0; s<rows-i-1; ++s) {
            cout<<"  ";
        }
        for(int j=0; j<=i; ++j) {
            long long val=fct(i)/(fct(j) * fct(i-j));
            cout<<val<< "   ";
        }
        cout<<endl;
    }
    return 0;
}
